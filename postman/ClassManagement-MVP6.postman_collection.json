                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.collectionVariables.set('attemptId', pm.response.json().data.attemptId);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get taking (capture questions)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/student/assignments/attempts/{{attemptId}}/taking",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "student",
                                "assignments",
                                "attempts",
                                "{{attemptId}}",
                                "taking"
                            ]
                        },
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ]
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const qs = pm.response.json().data.questions;",
                                    "for (const q of qs) {",
                                    "  if (q.type === 'ShortWriting' || q.type === 'LongWriting') {",
                                    "    pm.collectionVariables.set('takingWritingQ', q.publicId);",
                                    "  } else {",
                                    "    pm.collectionVariables.set('takingSingleQ', q.publicId);",
                                    "    if (q.options && q.options.length) pm.collectionVariables.set('takingSingleOpt', q.options[0].publicId);",
                                    "  }",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Save answers",
                    "request": {
                        "method": "PATCH",
                        "url": {
                            "raw": "{{baseUrl}}/student/assignments/attempts/{{attemptId}}/answers",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "student",
                                "assignments",
                                "attempts",
                                "{{attemptId}}",
                                "answers"
                            ]
                        },
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{takingSingleQ}}\",\n      \"selectedOptionIds\": [\n        \"{{takingSingleOpt}}\"\n      ],\n      \"textAnswer\": null\n    },\n    {\n      \"questionId\": \"{{takingWritingQ}}\",\n      \"selectedOptionIds\": [],\n      \"textAnswer\": \"The sky scatters blue light (Rayleigh scattering).\"\n    }\n  ]\n}"
                        }
                    }
                },
                {
                    "name": "Submit attempt",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/student/assignments/attempts/{{attemptId}}/submit",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "student",
                                "assignments",
                                "attempts",
                                "{{attemptId}}",
                                "submit"
                            ]
                        }
                    }
                },
                {
                    "name": "Get result (score hidden — Manual policy)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/student/assignments/attempts/{{attemptId}}/result",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "student",
                                "assignments",
                                "attempts",
                                "{{attemptId}}",
                                "result"
                            ]
                        },
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ]
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('score not released yet', () => pm.expect(pm.response.json().data.scoreReleased).to.eql(false));"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
