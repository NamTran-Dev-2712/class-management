    "PendingConfirmTtlMinutes": 60,
    "CleanupCron": "*/30 * * * *",
    "CleanupBatchSize": 200,
    "MaxImageBytes": 5242880,
    "MaxAudioBytes": 20971520,
    "MaxVideoBytes": 104857600,
    "AllowedImageTypes": ["image/png", "image/jpeg", "image/gif", "image/webp"],
    "AllowedAudioTypes": ["audio/mpeg", "audio/mp4", "audio/ogg", "audio/wav", "audio/webm"],
    "AllowedVideoTypes": ["video/mp4", "video/webm", "video/ogg"]
