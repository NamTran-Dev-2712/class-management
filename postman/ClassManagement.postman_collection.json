{
    "info": {
        "name": "Class Management API",
        "_postman_id": "b1a7e2c0-0000-4000-9000-classmgmt0001",
        "description": "End-to-end collection for the Class Management API: Auth, Admin Subjects, and Admin User Management. Auth is cookie-based — run 'Auth / Login (Admin)' first and Postman's cookie jar carries access_token/refresh_token to the rest of the requests. Set {{baseUrl}} via the environment.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register (Student)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.collectionVariables.set('selfEmail', 'self_' + Date.now() + '@example.com');"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"displayName\": \"Self Signup\",\n  \"email\": \"{{selfEmail}}\",\n  \"password\": \"Passw0rd!23\",\n  \"role\": \"Student\"\n}"
                        }
                    }
                },
                {
                    "name": "Login (Admin)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
                        }
                    }
                },
                {
                    "name": "Get Me",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
                    }
                },
                {
                    "name": "Refresh Token",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
                    }
                },
                {
                    "name": "Update Profile",
                    "request": {
                        "method": "PATCH",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"displayName\": \"Updated Name\",\n  \"bio\": \"Hello\",\n  \"avatarUrl\": null,\n  \"phoneNumber\": null\n}"
                        }
                    }
                },
                {
                    "name": "Change Password",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"currentPassword\": \"Passw0rd!23\",\n  \"newPassword\": \"Passw0rd!99\",\n  \"confirmNewPassword\": \"Passw0rd!99\"\n}"
                        }
                    }
                },
                {
                    "name": "Forgot Password",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
                        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{selfEmail}}\"\n}" }
                    }
                },
                {
                    "name": "Reset Password",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{selfEmail}}\",\n  \"otp\": \"000000\",\n  \"newPassword\": \"Passw0rd!77\",\n  \"confirmNewPassword\": \"Passw0rd!77\"\n}"
                        }
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
                    }
                }
            ]
        },
        {
            "name": "Admin Subjects",
            "item": [
                {
                    "name": "List Subjects",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/subjects?pageNumber=1&pageSize=10&sortBy=displayOrder&sortOrder=asc",
                            "host": ["{{baseUrl}}"],
                            "path": ["subjects"],
                            "query": [
                                { "key": "pageNumber", "value": "1" },
                                { "key": "pageSize", "value": "10" },
                                { "key": "sortBy", "value": "displayOrder" },
                                { "key": "sortOrder", "value": "asc" },
                                { "key": "searchTerm", "value": "", "disabled": true },
                                { "key": "isActive", "value": "true", "disabled": true }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Subject",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (json && json.data && json.data.publicId) {",
                                    "  pm.collectionVariables.set('subjectId', json.data.publicId);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/subjects", "host": ["{{baseUrl}}"], "path": ["subjects"] },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Mathematics {{$timestamp}}\",\n  \"description\": \"Core math subject\",\n  \"isActive\": true,\n  \"displayOrder\": 0\n}"
                        }
                    }
                },
                {
                    "name": "Get Subject By Id",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/subjects/{{subjectId}}", "host": ["{{baseUrl}}"], "path": ["subjects", "{{subjectId}}"] }
                    }
                },
                {
                    "name": "Update Subject",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/subjects/{{subjectId}}", "host": ["{{baseUrl}}"], "path": ["subjects", "{{subjectId}}"] },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Mathematics (updated)\",\n  \"description\": \"Updated description\",\n  \"isActive\": true,\n  \"displayOrder\": 1\n}"
                        }
                    }
                },
                {
                    "name": "Delete Subject",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/subjects/{{subjectId}}", "host": ["{{baseUrl}}"], "path": ["subjects", "{{subjectId}}"] }
                    }
                }
            ]
        },
        {
            "name": "Admin Users",
            "item": [
                {
                    "name": "List Users",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/admin/users?pageNumber=1&pageSize=10&sortBy=displayName&sortOrder=asc",
                            "host": ["{{baseUrl}}"],
                            "path": ["admin", "users"],
                            "query": [
                                { "key": "pageNumber", "value": "1" },
                                { "key": "pageSize", "value": "10" },
                                { "key": "sortBy", "value": "displayName" },
                                { "key": "sortOrder", "value": "asc" },
                                { "key": "searchTerm", "value": "", "disabled": true },
                                { "key": "role", "value": "Teacher", "disabled": true },
                                { "key": "isLocked", "value": "true", "disabled": true }
                            ]
                        }
                    }
                },
                {
                    "name": "Create User",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.collectionVariables.set('newUserEmail', 'teacher_' + Date.now() + '@example.com');"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (json && json.data && json.data.publicId) {",
                                    "  pm.collectionVariables.set('userId', json.data.publicId);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"displayName\": \"New Teacher\",\n  \"email\": \"{{newUserEmail}}\",\n  \"role\": \"Teacher\",\n  \"phoneNumber\": null\n}"
                        }
                    }
                },
                {
                    "name": "Get User By Id",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}"] }
                    }
                },
                {
                    "name": "Update User",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}"] },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"displayName\": \"Renamed Teacher\",\n  \"role\": \"Student\",\n  \"phoneNumber\": \"+84 123 456 789\"\n}"
                        }
                    }
                },
                {
                    "name": "Lock User",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}/lock", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}", "lock"] }
                    }
                },
                {
                    "name": "Unlock User",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}/unlock", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}", "unlock"] }
                    }
                },
                {
                    "name": "Delete User",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}"] }
                    }
                }
            ]
        }
    ],
    "variable": [
        { "key": "subjectId", "value": "" },
        { "key": "userId", "value": "" },
        { "key": "newUserEmail", "value": "" },
        { "key": "selfEmail", "value": "" }
    ]
}
