                {
                    "name": "Get attempt grading detail",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/teacher/assignments/attempts/{{attemptId}}/grading",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "teacher",
                                "assignments",
                                "attempts",
                                "{{attemptId}}",
                                "grading"
                            ]
                        },
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ]
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const qs = pm.response.json().data.questions;",
                                    "const w = qs.find(q => q.isWriting);",
                                    "if (w) pm.collectionVariables.set('gradingWritingQ', w.questionPublicId);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Grade attempt (writing answer)",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/teacher/assignments/attempts/{{attemptId}}/grade",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "teacher",
                                "assignments",
                                "attempts",
                                "{{attemptId}}",
                                "grade"
                            ]
                        },
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"grades\": [\n    {\n      \"questionPublicId\": \"{{gradingWritingQ}}\",\n      \"score\": 4.0,\n      \"feedback\": \"Good \\u2014 add more detail next time.\"\n    }\n  ]\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('graded ok', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get report (stats + histogram)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/teacher/assignments/{{assignmentId}}/report",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "teacher",
                                "assignments",
                                "{{assignmentId}}",
                                "report"
                            ]
                        },
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ]
                    }
                },
                {
                    "name": "Export grades (CSV)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/teacher/assignments/{{assignmentId}}/export",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "teacher",
                                "assignments",
                                "{{assignmentId}}",
                                "export"
                            ]
                        }
                    }
                },
                {
                    "name": "Release grades (publish)",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/teacher/assignments/{{assignmentId}}/release-grades",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "teacher",
                                "assignments",
                                "{{assignmentId}}",
                                "release-grades"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "6. Student — View released result",
            "item": [
                {
                    "name": "Login Student",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
                        }
                    }
                },
                {
                    "name": "Get result (released — feedback + answers)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/student/assignments/attempts/{{attemptId}}/result",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "student",
                                "assignments",
                                "attempts",
                                "{{attemptId}}",
                                "result"
                            ]
                        },
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ]
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const d = pm.response.json().data;",
                                    "pm.test('score released', () => pm.expect(d.scoreReleased).to.eql(true));",
                                    "pm.test('total = auto 4 + manual 4', () => pm.expect(d.totalScore).to.eql(8));"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
