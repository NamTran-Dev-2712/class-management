# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=class_admin
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=class_management
POSTGRES_PORT=5432
# Use a named Docker volume (default) or an absolute host path e.g. /data/postgres
DB_DATA_PATH=postgres_data

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=your_secure_redis_password
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
# Use a named Docker volume (default) or an absolute host path e.g. /data/redis
REDIS_DATA_PATH=redis_data

# ── Resource limits ─────────────────────────────────────────
CPU_LIMIT_POSTGRES=1.0
MEM_LIMIT_POSTGRES=512m
CPU_LIMIT_REDIS=0.5
MEM_LIMIT_REDIS=256m

# ── App connection strings (reference — set in appsettings or env override) ──
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=class_management;Username=class_admin;Password=<POSTGRES_PASSWORD>
# Redis__ConnectionString=localhost:6379,password=<REDIS_PASSWORD>
