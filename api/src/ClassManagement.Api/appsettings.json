    "PaymentCheckout": { "PermitLimit": 10, "WindowSeconds": 60 },
    "PaymentWebhook": { "PermitLimit": 120, "WindowSeconds": 60 },
    "MediaPresign":   { "PermitLimit": 20, "WindowSeconds": 60 },
    "MediaWrite":     { "PermitLimit": 60, "WindowSeconds": 60 },
    "MediaLocalUpload": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Read":           { "PermitLimit": 120, "WindowSeconds": 60 }
