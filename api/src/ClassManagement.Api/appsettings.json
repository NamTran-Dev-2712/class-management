{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=class_management;Username=class_admin;Password=changeme;Include Error Detail=true"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=changeme",
    "DefaultExpiry": "01:00:00"
  },
  "Jwt": {
    "Issuer": "class-management-api",
    "Audience": "class-management-client",
    "SecretKey": "REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Seed": {
    "AdminEmail": "onboarding@resend.dev",
    "AdminPassword": "Admin@123456",
    "AdminDisplayName": "System Administrator"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "RateLimit": {
    "Login":          { "PermitLimit": 5,  "WindowSeconds": 60 },
    "Register":       { "PermitLimit": 3,  "WindowSeconds": 60 },
    "Refresh":        { "PermitLimit": 10, "WindowSeconds": 60 },
    "ChangePassword": { "PermitLimit": 3,  "WindowSeconds": 60 },
    "UpdateProfile":  { "PermitLimit": 10, "WindowSeconds": 60 },
    "ForgotPassword": { "PermitLimit": 3,  "WindowSeconds": 60 },
    "ResetPassword":  { "PermitLimit": 5,  "WindowSeconds": 60 },
    "Logout":         { "PermitLimit": 10, "WindowSeconds": 60 },
    "SubjectWrite":   { "PermitLimit": 20, "WindowSeconds": 60 },
    "UserWrite":      { "PermitLimit": 20, "WindowSeconds": 60 },
    "ClassWrite":     { "PermitLimit": 30, "WindowSeconds": 60 },
    "ClassJoin":      { "PermitLimit": 5,  "WindowSeconds": 60 },
    "QuestionWrite":  { "PermitLimit": 30, "WindowSeconds": 60 },
    "ExamWrite":      { "PermitLimit": 30, "WindowSeconds": 60 },
    "AssignmentWrite":{ "PermitLimit": 30, "WindowSeconds": 60 },
    "AttemptStart":   { "PermitLimit": 10, "WindowSeconds": 60 },
    "AttemptSave":    { "PermitLimit": 20, "WindowSeconds": 60 },
    "AttemptSubmit":  { "PermitLimit": 10, "WindowSeconds": 60 },
    "Read":           { "PermitLimit": 120, "WindowSeconds": 60 }
  },
  "Classroom": {
    "MaxClassesPerTeacher": 0
  },
  "QuestionBank": {
    "MaxQuestionsPerTeacher": 0
  },
  "ExamBuilder": {
    "MaxExamsPerTeacher": 0
  },
  "Assignment": {
    "MaxAssignmentsPerTeacher": 0,
    "AutoSaveMinIntervalSeconds": 30,
    "LifecycleSweepCron": "* * * * *",
    "MaxTimeLimitMinutes": 1440,
    "MaxAttemptsCap": 100,
    "LifecycleBatchSize": 200
  },
  "OutputCache": {
    "Enabled": true,
    "DefaultExpirySeconds": 60,
    "PerUserExpirySeconds": 30
  },
  "PasswordReset": {
    "OtpLength": 6,
    "ExpiryMinutes": 15,
    "MaxAttempts": 5
  },
  "Resend": {
    "ApiKey": "REPLACE_WITH_RESEND_API_KEY",
    "FromEmail": "no-reply@classmanagement.local",
    "FromName": "Class Management"
  },
  "Hangfire": {
    "Enabled": true,
    "EnableServer": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 0
  },
  "ClientApp": {
    "BaseUrl": "http://localhost:5173",
    "ResetPasswordPath": "/reset-password",
    "LoginPath": "/login"
  },
  "Localization": {
    "DefaultCulture": "en",
    "SupportedCultures": [ "en", "vi" ]
  },
  "AllowedHosts": "*"
}
