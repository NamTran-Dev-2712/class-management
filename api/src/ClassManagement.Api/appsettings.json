  "Classroom": {
    "MaxClassesPerTeacher": 0
  },
  "QuestionBank": {
    "MaxQuestionsPerTeacher": 0
  },
  "ExamBuilder": {
    "MaxExamsPerTeacher": 0
  },
  "Assignment": {
    "MaxAssignmentsPerTeacher": 0,
    "AutoSaveMinIntervalSeconds": 30,
    "LifecycleSweepCron": "* * * * *",
    "MaxTimeLimitMinutes": 1440,
    "MaxAttemptsCap": 100,
    "LifecycleBatchSize": 200,
    "ReportHistogramBuckets": 10,
    "MaxExportRows": 500,
    "MaxViolationsCap": 100
  },
  "Notification": {
    "DueSoonSweepCron": "0 * * * *",
    "CleanupCron": "30 3 * * *"
  },
  "Subscription": {
    "GracePeriodDays": 3,
    "ExpiringNoticeDays": 3,
    "LifecycleSweepCron": "*/15 * * * *"
  },
  "Payment": {
    "UseFakeProvider": true,
    "OrderTimeoutMinutes": 30,
    "ReturnUrlBase": "http://localhost:5173/teacher/subscription/return",
