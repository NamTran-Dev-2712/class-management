                {
                    "name": "Start attempt",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/student/assignments/{{assignmentId}}/attempts",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "student",
                                "assignments",
                                "{{assignmentId}}",
                                "attempts"
